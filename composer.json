{
    "name": "urbanodev/visitas",
    "description": "Contador de visitas da casa para site público Laravel: sem cookie, sem IP guardado, robô e prefetch fora, visitante do dia por marca com sal que se apaga sozinho.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "UrbanoDev\\Visitas\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UrbanoDev\\Visitas\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "UrbanoDev\\Visitas\\VisitasServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
